# buzz-ai — the env vars the container expects. COMMITTED REFERENCE (public values only).
#
# You do NOT normally fill this in. The real values come from Bitwarden Secrets
# Manager at runtime: `./start.sh` runs `bws`, then tools/map_secrets.py projects the
# Bitwarden names onto the names below. This file exists so the full set is written
# down somewhere readable — useful when debugging "which var was missing?".
#
# Do NOT put real secrets here (it's tracked in git). If you ever do need a manual
# run, copy to `.env` (git-ignored) and fill it there.

# ── Shared, non-secret ──────────────────────────────────────────────
BUZZ_RELAY_URL=wss://yc2897.communities.buzz.xyz
BUZZ_ACP_AGENT_OWNER=a4753e3ba9c4c812a052dfe4e414e14469d3c60d09dbd07f76d3d70236445826
CLAUDE_MODEL=claude-opus-4-8
CODEX_MODEL=gpt-5.5
CLAUDE_EFFORT=high
CODEX_EFFORT=high

