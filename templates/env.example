# buzz-ai — DigitalOcean env vars (app-level). COMMITTED TEMPLATE (public values only).
#
# Usage: copy this to `.env` (git-ignored) and fill the 12 SECRET values there —
#   cp env.example .env   # then edit .env, never this file
# Do NOT put real secrets in env.example (it's tracked in git).
#
# In the DO UI: flip "Encrypt" ON for every secret. Enter the 5 *_AUTH_TAG values
# INDIVIDUALLY (they're JSON with quotes/commas — a bulk .env import can mangle them).

# ── Shared, non-secret ──────────────────────────────────────────────
BUZZ_RELAY_URL=wss://yc2897.communities.buzz.xyz
BUZZ_ACP_AGENT_OWNER=f6e23876ed6c7c82486c371a0f577f08c3d7025008a35900be0b7129757a1122
CLAUDE_MODEL=claude-opus-4-8
CODEX_MODEL=gpt-5.5
CLAUDE_EFFORT=high
CODEX_EFFORT=high

# ── Delegation allowlists (full mesh — hex pubkeys, non-secret) ─────
