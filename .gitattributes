# Force LF on everything that is executed, regardless of the platform that checks
# it out. Git for Windows defaults to core.autocrlf=true, which rewrites these to
# CRLF — and a CRLF shebang makes the kernel look for an interpreter named
# "bash\r", failing with:
#     env: 'bash\r': No such file or directory
#
# The Dockerfile already strips CR from run-agent.sh + supervisord.conf (they get
# COPY'd into the image), but start.py and tools/*.py run on the HOST, so they
# need protecting here.
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.zip  binary
